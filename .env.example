# Copy to .env for local runs. Do NOT commit real secrets.

# Go API
HTTP_ADDR=:8081
MYSQL_DSN=rdp_app:rdp_pass@tcp(127.0.0.1:3306)/rdp_pool?parseTime=true&loc=Local&charset=utf8mb4
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
JWT_SECRET=change-me-pool-user-jwt
ADMIN_JWT_SECRET=change-me-admin-jwt
CREDENTIAL_AES_KEY=0123456789abcdef0123456789abcdef

# Pool defaults (seconds)
PENDING_CONFIRM_SEC=90
HEARTBEAT_INTERVAL_SEC=15
LEASE_TTL_SEC=60
MAX_OCCUPATION_TTL_SEC=14400
OFFER_TTL_SEC=60
TICKET_TTL_SEC=120
LINGER_OFFER_SCAN_SEC=20

# Seed / demo Windows resource (placeholders — put real password only in local .env)
DEMO_GROUP_CODE=office
DEMO_GROUP_NAME=办公桌面
DEMO_RESOURCE_NAME=win-test-01
DEMO_RESOURCE_HOST=10.126.126.4
DEMO_RESOURCE_PORT=3389
DEMO_RDP_USERNAME=zzm
DEMO_RDP_PASSWORD=CHANGE_ME

# Demo terminal user (local only)
DEMO_POOL_USER=demo
DEMO_POOL_PASSWORD=demo123

# MySQL root (compose)
MYSQL_ROOT_PASSWORD=root_pass_change_me
MYSQL_RDP_USER=rdp_app
MYSQL_RDP_PASSWORD=rdp_pass

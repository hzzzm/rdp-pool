FROM golang:1.22-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/rdp-pool-seed ./cmd/seed

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=build /out/rdp-pool-seed /rdp-pool-seed
ENTRYPOINT ["/rdp-pool-seed"]
